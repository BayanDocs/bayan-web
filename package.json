{
  "name": "bayan-web",
  "version": "0.0.0",
  "private": true,
  "description": "BayanDocs in the browser: a thin React shell around the bayan-core engine.",
  "license": "GPL-3.0-or-later WITH AdditionRef-BayanDocs-App-Store-Permission",
  "repository": "github:BayanDocs/bayan-web",
  "type": "module",
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/sri.ts dist && node scripts/check-licenses.ts dist && node scripts/size-report.ts dist",
    "preview": "vite preview",
    "check:policy": "node scripts/check-policy.ts",
    "check:lockfile": "node scripts/check-lockfile-integrity.ts",
    "check:engine": "node scripts/check-engine.ts",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit.ts",
    "verify": "pnpm run check:policy && pnpm run check:lockfile && pnpm run check:engine && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:e2e && pnpm run audit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
